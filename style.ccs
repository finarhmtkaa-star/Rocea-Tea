/* ============================================================
   ROCÈA Herbal Tea — Stylesheet
   ============================================================ */

:root{
  --warm-white:#FFFBF7;
  --cream:#FFF2E6;
  --cream-2:#FBE8D6;
  --soft-pink:#FADDE1;
  --dusty-rose:#E59AA6;
  --rosella:#B23A48;
  --rosella-dark:#8B1E2D;
  --rosella-light:#D96070;
  --sage:#8FA88C;
  --sage-dark:#5C7857;
  --lemon:#F7E8A4;
  --text:#2E1F1C;
  --text-soft:#6B5B57;
  --muted:#A79893;
  --line:#F0E1D6;
  --shadow-sm:0 2px 8px rgba(139,30,45,.06);
  --shadow-md:0 8px 24px rgba(139,30,45,.08);
  --shadow-lg:0 16px 40px rgba(139,30,45,.12);
  --radius-sm:10px;
  --radius:16px;
  --radius-lg:24px;
  --radius-xl:32px;
  --ff-display:'Fraunces', serif;
  --ff-body:'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --header-h:64px;
  --bn-h:64px;
}

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{overflow-x:hidden;}
body{
  font-family:var(--ff-body);
  background:var(--warm-white);
  color:var(--text);
  font-size:15px;
  line-height:1.55;
  padding-bottom:calc(var(--bn-h) + 8px);
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,textarea,select{font-family:inherit;font-size:15px;}
a{color:inherit;text-decoration:none;}

/* ============================================================
   HEADER
   ============================================================ */
.header{
  position:sticky;top:0;z-index:100;
  background:rgba(255,251,247,.85);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}
.header-inner{
  max-width:1200px;margin:0 auto;
  height:var(--header-h);
  padding:0 16px;
  display:flex;align-items:center;justify-content:space-between;gap:12px;
}
.logo{display:flex;align-items:center;gap:10px;}
.logo-mark{
  width:40px;height:40px;border-radius:12px;
  background:linear-gradient(135deg,var(--rosella),var(--rosella-dark));
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  box-shadow:var(--shadow-sm);
  position:relative;
}
.logo-mark img{width:100%;height:100%;object-fit:cover;}
.logo-fallback{
  display:none;color:#fff;font-family:var(--ff-display);
  font-weight:700;font-size:20px;
}
.logo-mark img[style*="display:none"] + .logo-fallback{display:flex !important;}
.logo-text{display:flex;flex-direction:column;line-height:1;}
.logo-text strong{
  font-family:var(--ff-display);
  font-size:18px;font-weight:700;letter-spacing:.5px;
  color:var(--rosella-dark);
}
.logo-text small{font-size:10px;color:var(--text-soft);letter-spacing:1.5px;text-transform:uppercase;}

.nav-desktop{display:none;gap:6px;}
.nav-link{
  padding:8px 14px;border-radius:999px;
  font-size:14px;font-weight:600;color:var(--text-soft);
  transition:.2s;
}
.nav-link:hover{background:var(--cream);color:var(--rosella-dark);}
.nav-link.active{background:var(--rosella);color:#fff;}

.header-actions{display:flex;gap:6px;}
.icon-btn{
  width:40px;height:40px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  color:var(--text);position:relative;
  transition:.2s;
}
.icon-btn:hover{background:var(--cream);color:var(--rosella-dark);}
.icon-btn svg{width:20px;height:20px;}
.cart-badge{
  position:absolute;top:2px;right:2px;
  min-width:18px;height:18px;padding:0 4px;
  background:var(--rosella);color:#fff;
  border-radius:999px;font-size:10px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  transform:scale(0);transition:transform .3s cubic-bezier(.34,1.56,.64,1);
}
.cart-badge.show{transform:scale(1);}
.cart-badge.bump{animation:bump .4s;}
@keyframes bump{0%{transform:scale(1)}50%{transform:scale(1.35)}100%{transform:scale(1)}}

.search-bar{
  max-height:0;overflow:hidden;transition:max-height .3s ease;
  border-top:0 solid var(--line);
}
.search-bar.open{max-height:70px;border-top-width:1px;}
.search-inner{
  max-width:1200px;margin:0 auto;
  display:flex;align-items:center;gap:8px;
  padding:12px 16px;
}
.search-inner svg{width:18px;height:18px;color:var(--muted);flex-shrink:0;}
.search-inner input{
  flex:1;border:none;background:transparent;outline:none;
  font-size:15px;color:var(--text);
}
.search-inner button{
  width:28px;height:28px;border-radius:8px;
  color:var(--muted);font-size:14px;
}
.search-inner button:hover{background:var(--cream);color:var(--rosella);}

/* ============================================================
   PAGES
   ============================================================ */
#app{max-width:1200px;margin:0 auto;padding:0 16px;}
.page{display:none;padding:20px 0 40px;animation:fadeUp .35s ease;}
.page.active{display:block;}
@keyframes fadeUp{
  from{opacity:0;transform:translateY(12px);}
  to{opacity:1;transform:translateY(0);}
}
.hidden{display:none !important;}

.page-head{margin-bottom:20px;}
.page-head h1{
  font-family:var(--ff-display);
  font-size:26px;font-weight:700;color:var(--rosella-dark);
  margin-bottom:4px;
}
.page-head p{color:var(--text-soft);font-size:14px;}
.back-btn{
  font-size:13px;color:var(--text-soft);font-weight:600;
  padding:6px 0;margin-bottom:8px;
  transition:.2s;
}
.back-btn:hover{color:var(--rosella);}

.section{padding:36px 0;}
.section-head{text-align:center;margin-bottom:28px;}
.eyebrow{
  display:inline-block;
  font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:var(--rosella);margin-bottom:8px;
}
.section-head h2{
  font-family:var(--ff-display);
  font-size:28px;font-weight:700;color:var(--rosella-dark);
  margin-bottom:8px;
}
.section-desc{color:var(--text-soft);font-size:14px;max-width:520px;margin:0 auto;}

/* ============================================================
   HERO
   ============================================================ */
.hero{
  display:grid;gap:28px;
  padding:24px 0 12px;
}
.hero-content{order:2;text-align:center;}
.hero-visual{order:1;position:relative;height:300px;}

.hero-badge{
  display:inline-block;
  background:var(--soft-pink);color:var(--rosella-dark);
  font-size:12px;font-weight:700;
  padding:6px 14px;border-radius:999px;
  margin-bottom:14px;
}
.hero-content h1{
  font-family:var(--ff-display);
  font-size:44px;font-weight:700;line-height:1;
  color:var(--rosella-dark);
  letter-spacing:-1px;
}
.hero-content h1 span{display:block;color:var(--rosella);font-style:italic;font-size:34px;}
.tagline{
  font-family:var(--ff-display);font-style:italic;
  color:var(--sage-dark);font-size:16px;
  margin:8px 0 12px;
}
.hero-desc{color:var(--text-soft);font-size:15px;margin-bottom:22px;}
.hero-buttons{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:24px;}
.hero-stats{
  display:flex;justify-content:center;gap:24px;
  padding-top:18px;border-top:1px dashed var(--line);
}
.hero-stats div{display:flex;flex-direction:column;align-items:center;}
.hero-stats strong{
  font-family:var(--ff-display);font-size:20px;color:var(--rosella);
}
.hero-stats span{font-size:11px;color:var(--text-soft);letter-spacing:.5px;}

.hero-circle{
  position:absolute;inset:0;margin:auto;
  width:260px;height:260px;border-radius:50%;
  background:radial-gradient(circle at 30% 30%,var(--soft-pink),var(--cream-2));
  box-shadow:inset 0 0 60px rgba(255,255,255,.6);
}
.hero-flower{
  position:absolute;inset:0;margin:auto;
  width:240px;height:240px;border-radius:50%;
  object-fit:cover;opacity:.9;
  animation:float 6s ease-in-out infinite;
}
.hero-product{
  position:absolute;width:110px;height:150px;
  border-radius:16px;overflow:hidden;
  filter:drop-shadow(0 12px 24px rgba(139,30,45,.25));
  animation:float 5s ease-in-out infinite;
}
.hero-product img{width:100%;height:100%;object-fit:contain;}
.hero-product.placeholder{
  background:linear-gradient(180deg,var(--soft-pink),var(--rosella-light));
}
.hero-p1{left:6%;bottom:8%;animation-delay:0s;}
.hero-p2{right:6%;top:8%;animation-delay:1s;}
@keyframes float{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-10px);}
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 22px;border-radius:999px;
  font-size:14px;font-weight:700;
  transition:.25s cubic-bezier(.34,1.56,.64,1);
  white-space:nowrap;
}
.btn-primary{
  background:linear-gradient(135deg,var(--rosella),var(--rosella-dark));
  color:#fff;
  box-shadow:0 6px 18px rgba(178,58,72,.3);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(178,58,72,.4);}
.btn-primary:active{transform:translateY(0);}
.btn-primary:disabled{opacity:.6;cursor:not-allowed;transform:none;}
.btn-ghost{
  background:var(--cream);color:var(--rosella-dark);
  border:1px solid var(--line);
}
.btn-ghost:hover{background:var(--soft-pink);}
.btn-block{width:100%;padding:16px;font-size:15px;}

/* ============================================================
   ABOUT ROSELLA
   ============================================================ */
.about-rosella{background:linear-gradient(180deg,transparent,var(--cream) 30%,var(--cream) 70%,transparent);}
.about-grid{
  display:grid;grid-template-columns:1fr;gap:12px;
  max-width:900px;margin:0 auto;
}
.about-card{
  background:#fff;border-radius:var(--radius);
  padding:20px;text-align:center;
  box-shadow:var(--shadow-sm);
  border:1px solid var(--line);
  transition:.25s;
}
.about-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);}
.about-icon{font-size:28px;margin-bottom:8px;}
.about-card h3{
  font-family:var(--ff-display);font-size:16px;font-weight:700;
  color:var(--rosella-dark);margin-bottom:6px;
}
.about-card p{font-size:13px;color:var(--text-soft);line-height:1.5;}
.disclaimer{
  text-align:center;font-size:11px;color:var(--muted);
  margin-top:20px;font-style:italic;
}

/* ============================================================
   PRODUCT CARD
   ============================================================ */
.product-grid{
  display:grid;grid-template-columns:1fr;gap:16px;
}
.product-card{
  background:#fff;border-radius:var(--radius-lg);
  overflow:hidden;
  box-shadow:var(--shadow-sm);
  border:1px solid var(--line);
  transition:.3s;
  display:flex;flex-direction:column;
}
.product-card:hover{
  transform:translateY(-4px);
  box-shadow:var(--shadow-lg);
}
.pc-image{
  position:relative;
  aspect-ratio:1/1;
  background:linear-gradient(135deg,var(--cream),var(--cream-2));
  overflow:hidden;
}
.pc-image img{width:100%;height:100%;object-fit:cover;}
.pc-image.placeholder::after{
  content:attr(data-emoji);
  position:absolute;inset:0;
  display:flex;align-items:center;justify-content:center;
  font-size:80px;
  background:linear-gradient(135deg,var(--soft-pink),var(--cream-2));
}
.fav-btn{
  position:absolute;top:10px;right:10px;
  width:38px;height:38px;border-radius:50%;
  background:rgba(255,255,255,.9);
  backdrop-filter:blur(6px);
  display:flex;align-items:center;justify-content:center;
  font-size:16px;color:var(--dusty-rose);
  box-shadow:var(--shadow-sm);
  transition:.2s;
  z-index:2;
}
.fav-btn:hover{transform:scale(1.1);}
.fav-btn.active{color:var(--rosella);animation:heartPop .4s;}
@keyframes heartPop{
  0%{transform:scale(1);}
  50%{transform:scale(1.4);}
  100%{transform:scale(1);}
}
.pc-badge{
  position:absolute;top:10px;left:10px;
  background:var(--rosella);color:#fff;
  font-size:10px;font-weight:700;
  padding:4px 10px;border-radius:999px;
  letter-spacing:.5px;text-transform:uppercase;
}
.pc-body{padding:16px;display:flex;flex-direction:column;gap:8px;flex:1;}
.pc-name{
  font-family:var(--ff-display);
  font-size:19px;font-weight:700;color:var(--rosella-dark);
}
.pc-size{
  display:inline-block;
  font-size:11px;font-weight:600;color:var(--sage-dark);
  background:var(--sage);opacity:.85;color:#fff;
  padding:3px 10px;border-radius:999px;align-self:flex-start;
}
.pc-desc{font-size:13px;color:var(--text-soft);line-height:1.5;}
.pc-compo{font-size:11px;color:var(--muted);font-style:italic;}
.pc-price{
  font-family:var(--ff-display);
  font-size:22px;font-weight:700;color:var(--rosella);
  margin-top:4px;
}

.qty-row{
  display:flex;align-items:center;justify-content:space-between;
  gap:10px;margin-top:6px;
}
.qty-label{font-size:12px;color:var(--text-soft);font-weight:600;}
.qty-control{
  display:flex;align-items:center;gap:0;
  background:var(--cream);border-radius:999px;
  padding:3px;
}
.qty-btn{
  width:34px;height:34px;border-radius:50%;
  background:#fff;color:var(--rosella-dark);
  font-size:18px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow-sm);
  transition:.15s;
}
.qty-btn:active{transform:scale(.9);}
.qty-btn:disabled{opacity:.35;cursor:not-allowed;}
.qty-value{
  min-width:34px;text-align:center;
  font-weight:700;font-size:15px;color:var(--rosella-dark);
}
.pc-subtotal{
  font-size:12px;color:var(--text-soft);
  display:flex;justify-content:space-between;
  padding-top:8px;border-top:1px dashed var(--line);
}
.pc-subtotal strong{color:var(--rosella);font-family:var(--ff-display);font-size:15px;}

.pc-actions{display:flex;gap:8px;margin-top:8px;}
.pc-actions .btn{flex:1;padding:11px 12px;font-size:12.5px;}

/* ============================================================
   CART
   ============================================================ */
.cart-layout{display:grid;gap:16px;}
.cart-item{
  background:#fff;border-radius:var(--radius);
  padding:12px;display:grid;
  grid-template-columns:80px 1fr;
  gap:12px;
  box-shadow:var(--shadow-sm);
  border:1px solid var(--line);
  margin-bottom:12px;
  animation:fadeUp .3s ease;
}
.ci-img{
  width:80px;height:80px;border-radius:12px;overflow:hidden;
  background:var(--cream);
}
.ci-img img{width:100%;height:100%;object-fit:cover;}
.ci-img.placeholder::after{
  content:attr(data-emoji);
  display:flex;align-items:center;justify-content:center;
  height:100%;font-size:32px;
}
.ci-info{display:flex;flex-direction:column;gap:4px;min-width:0;}
.ci-name{
  font-family:var(--ff-display);font-weight:700;
  font-size:15px;color:var(--rosella-dark);
}
.ci-price{font-size:12px;color:var(--text-soft);}
.ci-row{
  display:flex;align-items:center;justify-content:space-between;
  gap:8px;margin-top:6px;flex-wrap:wrap;
}
.ci-sub{
  font-family:var(--ff-display);font-weight:700;
  color:var(--rosella);font-size:15px;
}
.ci-remove{
  font-size:11px;color:var(--muted);
  padding:4px 8px;border-radius:8px;
  transition:.2s;
}
.ci-remove:hover{background:#FEE;color:var(--rosella);}

.cart-summary{
  background:#fff;border-radius:var(--radius);
  padding:18px;
  box-shadow:var(--shadow-sm);
  border:1px solid var(--line);
  position:sticky;top:calc(var(--header-h) + 12px);
}
.cart-summary h3{
  font-family:var(--ff-display);font-size:16px;
  color:var(--rosella-dark);margin-bottom:12px;
}
.sum-row{
  display:flex;justify-content:space-between;
  padding:8px 0;font-size:14px;color:var(--text-soft);
  border-bottom:1px dashed var(--line);
}
.sum-row.total{
  font-size:16px;font-weight:700;color:var(--rosella-dark);
  border:none;padding-top:14px;
}
.sum-row.total strong{
  font-family:var(--ff-display);font-size:22px;
  color:var(--rosella);
}

/* ============================================================
   CHECKOUT
   ============================================================ */
.checkout-layout{display:grid;gap:16px;}
.form-card{
  background:#fff;border-radius:var(--radius);
  padding:18px;
  box-shadow:var(--shadow-sm);
  border:1px solid var(--line);
  margin-bottom:14px;
}
.form-card h3{
  font-family:var(--ff-display);font-size:16px;
  color:var(--rosella-dark);margin-bottom:14px;
}
.field{margin-bottom:14px;}
.field label{
  display:block;font-size:13px;font-weight:600;
  color:var(--text);margin-bottom:6px;
}
.field .req{color:var(--rosella);}
.field .opt{color:var(--muted);font-weight:400;font-size:11px;}
.field input,.field textarea{
  width:100%;padding:12px 14px;
  border:1.5px solid var(--line);
  border-radius:12px;
  background:var(--warm-white);
  outline:none;transition:.2s;
  resize:vertical;
}
.field input:focus,.field textarea:focus{
  border-color:var(--rosella);
  background:#fff;
  box-shadow:0 0 0 4px rgba(178,58,72,.08);
}
.field input.error,.field textarea.error{border-color:#E24;background:#FFF7F7;}
.err{
  display:block;font-size:11.5px;color:#D33;
  margin-top:4px;min-height:14px;
}

.pay-options{display:grid;gap:10px;}
.pay-option{
  display:grid;
  grid-template-columns:auto auto 1fr;
  align-items:center;gap:10px;
  padding:14px;
  border:1.5px solid var(--line);
  border-radius:12px;
  cursor:pointer;transition:.2s;
  background:var(--warm-white);
  position:relative;
}
.pay-option:hover{border-color:var(--dusty-rose);background:#fff;}
.pay-option input{position:absolute;opacity:0;pointer-events:none;}
.pay-icon{font-size:22px;}
.pay-label{font-weight:700;color:var(--text);font-size:14px;}
.pay-desc{
  grid-column:3;font-size:11.5px;color:var(--muted);
  margin-top:-4px;
}
.pay-option:has(input:checked){
  border-color:var(--rosella);
  background:linear-gradient(135deg,#FFF5F6,#fff);
  box-shadow:0 0 0 4px rgba(178,58,72,.08);
}
.pay-option:has(input:checked) .pay-label{color:var(--rosella-dark);}

.check-confirm{
  display:flex;gap:10px;align-items:flex-start;
  padding:14px;border-radius:12px;
  background:var(--cream);margin:8px 0;
  font-size:13px;line-height:1.5;
  cursor:pointer;
}
.check-confirm input{
  width:20px;height:20px;flex-shrink:0;
  accent-color:var(--rosella);cursor:pointer;margin-top:1px;
}

.checkout-summary{
  background:#fff;border-radius:var(--radius);
  padding:18px;
  box-shadow:var(--shadow-sm);
  border:1px solid var(--line);
}
.checkout-summary h3{
  font-family:var(--ff-display);font-size:16px;
  color:var(--rosella-dark);margin-bottom:14px;
}
.chk-item{
  display:flex;justify-content:space-between;
  gap:8px;padding:8px 0;
  border-bottom:1px dashed var(--line);
  font-size:13px;
}
.chk-item .chk-name{font-weight:600;color:var(--text);}
.chk-item .chk-name small{display:block;color:var(--muted);font-weight:400;font-size:11px;}
.chk-item .chk-price{font-weight:700;color:var(--rosella);white-space:nowrap;}
.summary-total{
  display:flex;justify-content:space-between;align-items:center;
  padding-top:14px;margin-top:6px;
  font-weight:700;font-size:15px;color:var(--text);
}
.summary-total strong{
  font-family:var(--ff-display);font-size:22px;color:var(--rosella);
}

/* ============================================================
   SUCCESS PAGE
   ============================================================ */
.success-wrap{padding:20px 0;display:flex;justify-content:center;}
.success-card{
  background:#fff;border-radius:var(--radius-lg);
  padding:32px 24px;text-align:center;
  max-width:480px;width:100%;
  box-shadow:var(--shadow-lg);
  border:1px solid var(--line);
}
.success-check{
  width:80px;height:80px;border-radius:50%;
  background:linear-gradient(135deg,var(--sage),var(--sage-dark));
  color:#fff;font-size:40px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 18px;
  animation:popIn .5s cubic-bezier(.34,1.56,.64,1);
  box-shadow:0 10px 30px rgba(92,120,87,.3);
}
@keyframes popIn{
  0%{transform:scale(0);}
  100%{transform:scale(1);}
}
.success-card h1{
  font-family:var(--ff-display);font-size:24px;
  color:var(--rosella-dark);margin-bottom:8px;
}
.success-card p{color:var(--text-soft);font-size:14px;margin-bottom:16px;}
.success-card .muted{font-size:13px;color:var(--muted);}
.order-id-box{
  background:var(--cream);border-radius:14px;
  padding:14px;margin:16px 0;
  display:flex;flex-direction:column;gap:4px;
}
.order-id-box span{font-size:11px;color:var(--text-soft);letter-spacing:1px;text-transform:uppercase;}
.order-id-box strong{
  font-family:var(--ff-display);font-size:20px;
  color:var(--rosella);letter-spacing:1px;
}
.success-actions{
  display:flex;gap:10px;margin-top:20px;flex-wrap:wrap;justify-content:center;
}

/* ============================================================
   ORDERS LIST
   ============================================================ */
.order-card{
  background:#fff;border-radius:var(--radius);
  padding:16px;margin-bottom:12px;
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
  transition:.2s;
}
.order-card:hover{box-shadow:var(--shadow-md);}
.order-head{
  display:flex;justify-content:space-between;align-items:flex-start;
  gap:10px;margin-bottom:10px;
  padding-bottom:10px;border-bottom:1px dashed var(--line);
}
.order-id{
  font-family:var(--ff-display);font-weight:700;
  color:var(--rosella-dark);font-size:15px;
}
.order-date{font-size:11.5px;color:var(--muted);}
.status-badge{
  font-size:11px;font-weight:700;
  padding:5px 10px;border-radius:999px;
  white-space:nowrap;
}
.status-Menunggu{background:#FFF3D6;color:#8A6D00;}
.status-Diproses{background:#DCEBFF;color:#1F4C8C;}
.status-Siap{background:#E0F5E5;color:#2A7A3E;}
.status-Selesai{background:#E5F6E0;color:#2E7A2A;}
.status-Dibatalkan{background:#FFE0E0;color:#A02020;}

.order-body{font-size:13px;color:var(--text-soft);margin-bottom:10px;}
.order-body .ord-line{display:flex;justify-content:space-between;padding:3px 0;}
.order-foot{
  display:flex;justify-content:space-between;align-items:center;
  padding-top:10px;border-top:1px dashed var(--line);
}
.order-total{
  font-family:var(--ff-display);font-size:17px;font-weight:700;
  color:var(--rosella);
}
.detail-btn{
  font-size:12.5px;font-weight:700;
  color:var(--rosella);padding:6px 12px;border-radius:999px;
  background:var(--soft-pink);
  transition:.2s;
}
.detail-btn:hover{background:var(--rosella);color:#fff;}

/* ============================================================
   ORDER DETAIL
   ============================================================ */
.detail-card{
  background:#fff;border-radius:var(--radius);
  padding:18px;margin-bottom:14px;
  border:1px solid var(--line);
  box-shadow:var(--shadow-sm);
}
.detail-card h3{
  font-family:var(--ff-display);font-size:15px;
  color:var(--rosella-dark);margin-bottom:12px;
  padding-bottom:8px;border-bottom:1px dashed var(--line);
}
.detail-row{
  display:flex;justify-content:space-between;gap:10px;
  padding:6px 0;font-size:13.5px;
}
.detail-row span:first-child{color:var(--text-soft);flex-shrink:0;}
.detail-row span:last-child{font-weight:600;text-align:right;}
.detail-prod{
  display:flex;justify-content:space-between;gap:10px;
  padding:8px 0;border-bottom:1px dashed var(--line);
  font-size:13.5px;
}
.detail-prod:last-child{border:none;}
.detail-prod .dp-name{font-weight:600;}
.detail-prod .dp-name small{display:block;color:var(--muted);font-weight:400;font-size:11.5px;}
.detail-prod .dp-price{color:var(--rosella);font-weight:700;}

/* ============================================================
   PROFILE
   ============================================================ */
.profile-hero{
  background:linear-gradient(135deg,var(--soft-pink),var(--cream));
  border-radius:var(--radius-lg);
  padding:32px 20px;text-align:center;
  margin-bottom:20px;
}
.profile-logo{
  width:70px;height:70px;border-radius:20px;
  background:linear-gradient(135deg,var(--rosella),var(--rosella-dark));
  color:#fff;font-size:34px;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 14px;
  box-shadow:var(--shadow-md);
}
.profile-hero h1{
  font-family:var(--ff-display);font-size:24px;
  color:var(--rosella-dark);margin-bottom:6px;
}
.profile-hero .tagline{margin-bottom:14px;}
.profile-desc{
  font-size:13.5px;color:var(--text-soft);
  max-width:420px;margin:0 auto;line-height:1.6;
}
.profile-menu{
  background:#fff;border-radius:var(--radius);
  border:1px solid var(--line);
  overflow:hidden;
  box-shadow:var(--shadow-sm);
}
.menu-item{
  display:flex;align-items:center;gap:14px;
  padding:16px 18px;
  width:100%;text-align:left;
  border-bottom:1px solid var(--line);
  background:#fff;
  transition:.2s;
}
.menu-item:last-child{border-bottom:none;}
.menu-item:hover{background:var(--warm-white);}
.menu-icon{font-size:20px;}
.menu-label{flex:1;font-weight:600;font-size:14px;color:var(--text);}
.menu-arrow{color:var(--muted);font-size:20px;font-weight:700;}

/* ============================================================
   FAQ
   ============================================================ */
.faq-list{display:flex;flex-direction:column;gap:10px;}
.faq-item{
  background:#fff;border-radius:var(--radius);
  border:1px solid var(--line);overflow:hidden;
  box-shadow:var(--shadow-sm);
}
.faq-q{
  width:100%;text-align:left;
  padding:16px 18px;
  font-weight:700;font-size:14px;
  color:var(--rosella-dark);
  display:flex;justify-content:space-between;align-items:center;gap:10px;
  transition:.2s;
}
.faq-q:hover{background:var(--warm-white);}
.faq-q .faq-icon{
  font-size:22px;color:var(--rosella);
  transition:transform .3s;flex-shrink:0;
}
.faq-item.open .faq-q .faq-icon{transform:rotate(45deg);}
.faq-a{
  max-height:0;overflow:hidden;
  transition:max-height .3s ease,padding .3s ease;
  padding:0 18px;
  font-size:13.5px;color:var(--text-soft);
  line-height:1.6;
}
.faq-item.open .faq-a{max-height:300px;padding:0 18px 16px;}

/* ============================================================
   BOTTOM NAV (Mobile)
   ============================================================ */
.bottom-nav{
  position:fixed;bottom:0;left:0;right:0;
  height:var(--bn-h);
  background:rgba(255,251,247,.95);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border-top:1px solid var(--line);
  display:flex;
  z-index:90;
  padding-bottom:env(safe-area-inset-bottom);
}
.bn-item{
  flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:2px;
  color:var(--muted);position:relative;
  transition:.2s;
}
.bn-item svg{width:20px;height:20px;transition:.2s;}
.bn-item span{font-size:10px;font-weight:600;}
.bn-item.active{color:var(--rosella);}
.bn-item.active svg{transform:translateY(-2px);}
.bn-badge{
  position:absolute;top:6px;right:calc(50% - 18px);
  min-width:16px;height:16px;padding:0 3px;
  background:var(--rosella);color:#fff;
  font-size:9px;font-weight:700;
  border-radius:999px;
  display:flex;align-items:center;justify-content:center;
  transform:scale(0);transition:transform .3s;
}
.bn-badge.show{transform:scale(1);}

/* ============================================================
   MODAL
   ============================================================ */
.modal{
  position:fixed;inset:0;z-index:200;
  display:none;
}
.modal.open{display:flex;align-items:flex-end;justify-content:center;}
.modal-backdrop{
  position:absolute;inset:0;
  background:rgba(46,31,28,.5);
  backdrop-filter:blur(4px);
  animation:fadeIn .25s;
}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-card{
  position:relative;z-index:1;
  background:var(--warm-white);
  width:100%;max-width:480px;
  border-radius:var(--radius-xl) var(--radius-xl) 0 0;
  padding:20px 18px 24px;
  animation:slideUp .35s cubic-bezier(.34,1.2,.64,1);
  max-height:85vh;overflow-y:auto;
}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-head{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:8px;
}
.modal-head h3{
  font-family:var(--ff-display);font-size:18px;
  color:var(--rosella-dark);
}
.modal-close{
  width:32px;height:32px;border-radius:50%;
  background:var(--cream);color:var(--text);
  font-size:14px;
}
.modal-close:hover{background:var(--soft-pink);}
.modal-sub{font-size:13px;color:var(--text-soft);margin-bottom:16px;}

.cs-list{display:flex;flex-direction:column;gap:8px;}
.cs-item{
  display:flex;align-items:center;gap:12px;
  padding:14px;background:#fff;border-radius:14px;
  border:1px solid var(--line);
  transition:.2s;
}
.cs-item:hover{transform:translateX(3px);border-color:var(--rosella);}
.cs-item.ig{background:linear-gradient(135deg,#FFF5F8,#fff);}
.cs-icon{font-size:22px;}
.cs-item div{flex:1;display:flex;flex-direction:column;}
.cs-item strong{font-size:14px;color:var(--text);}
.cs-item small{font-size:11px;color:var(--muted);}
.cs-arrow{color:var(--muted);font-size:20px;font-weight:700;}

/* ============================================================
   TOAST
   ============================================================ */
.toast-wrap{
  position:fixed;top:calc(var(--header-h) + 12px);left:50%;
  transform:translateX(-50%);
  z-index:300;
  display:flex;flex-direction:column;gap:8px;
  pointer-events:none;
  width:calc(100% - 32px);max-width:420px;
}
.toast{
  background:rgba(46,31,28,.95);
  color:#fff;
  padding:12px 16px;border-radius:14px;
  font-size:13px;font-weight:500;
  box-shadow:var(--shadow-lg);
  display:flex;align-items:center;gap:10px;
  animation:toastIn .35s cubic-bezier(.34,1.56,.64,1);
  backdrop-filter:blur(8px);
}
.toast.out{animation:toastOut .3s forwards;}
.toast-icon{
  width:24px;height:24px;border-radius:50%;
  background:var(--sage);color:#fff;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;flex-shrink:0;
}
.toast.err .toast-icon{background:#D33;}
@keyframes toastIn{
  from{opacity:0;transform:translateY(-20px) scale(.9);}
  to{opacity:1;transform:translateY(0) scale(1);}
}
@keyframes toastOut{
  to{opacity:0;transform:translateY(-20px) scale(.9);}
}

/* ============================================================
   LOADING OVERLAY
   ============================================================ */
.loading-overlay{
  position:fixed;inset:0;z-index:400;
  background:rgba(255,251,247,.85);
  backdrop-filter:blur(6px);
  display:flex;align-items:center;justify-content:center;
}
.loading-box{
  text-align:center;
  background:#fff;border-radius:var(--radius);
  padding:28px 32px;
  box-shadow:var(--shadow-lg);
}
.spinner{
  width:44px;height:44px;
  border:4px solid var(--soft-pink);
  border-top-color:var(--rosella);
  border-radius:50%;
  margin:0 auto 14px;
  animation:spin 0.9s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}
.loading-box p{
  font-weight:700;font-size:14px;color:var(--rosella-dark);
}

/* ============================================================
   EMPTY STATE
   ============================================================ */
.empty-state{
  text-align:center;padding:60px 20px;
}
.empty-icon{font-size:56px;margin-bottom:14px;}
.empty-state h3{
  font-family:var(--ff-display);font-size:18px;
  color:var(--rosella-dark);margin-bottom:6px;
}
.empty-state p{font-size:13.5px;color:var(--text-soft);margin-bottom:18px;}

/* ============================================================
   RESPONSIVE — TABLET & DESKTOP
   ============================================================ */
@media (min-width:640px){
  .about-grid{grid-template-columns:repeat(2,1fr);}
  .product-grid{grid-template-columns:repeat(2,1fr);}
  .cart-layout{grid-template-columns:1.6fr 1fr;}
  .checkout-layout{grid-template-columns:1.4fr 1fr;}
}

@media (min-width:900px){
  body{padding-bottom:0;font-size:15.5px;}
  #app{padding:0 32px;}
  .page{padding:28px 0 60px;}
  .header-inner{padding:0 32px;}
  .nav-desktop{display:flex;}
  .bottom-nav{display:none;}

  .hero{
    grid-template-columns:1.1fr 1fr;
    align-items:center;
    gap:40px;
    padding:40px 0 20px;
    min-height:calc(100vh - var(--header-h) - 60px);
  }
  .hero-content{order:1;text-align:left;}
  .hero-visual{order:2;height:480px;}
  .hero-buttons{justify-content:flex-start;}
  .hero-stats{justify-content:flex-start;gap:40px;}
  .hero-content h1{font-size:60px;}
  .hero-content h1 span{font-size:44px;}
  .hero-circle{width:400px;height:400px;}
  .hero-flower{width:360px;height:360px;}
  .hero-product{width:160px;height:220px;}
  .hero-p1{left:0;bottom:10%;}
  .hero-p2{right:0;top:10%;}

  .section{padding:60px 0;}
  .section-head h2{font-size:36px;}
  .page-head h1{font-size:32px;}
  .about-grid{grid-template-columns:repeat(4,1fr);}
  .product-grid{grid-template-columns:repeat(2,1fr);gap:24px;}

  .cart-layout{grid-template-columns:2fr 1fr;gap:24px;}
  .checkout-layout{grid-template-columns:1.5fr 1fr;gap:24px;}

  .modal.open{align-items:center;}
  .modal-card{
    border-radius:var(--radius-xl);
    animation:scaleIn .3s cubic-bezier(.34,1.2,.64,1);
  }
  @keyframes scaleIn{from{transform:scale(.9);opacity:0}to{transform:scale(1);opacity:1}}
}

@media (min-width:1100px){
  .product-grid{grid-template-columns:repeat(3,1fr);}
}